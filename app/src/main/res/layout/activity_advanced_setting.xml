                            android:layout_height="40dp"
                            android:text="重置"/>-->

                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/advanced_setting_effectSizeBonus_seekbar"
                        android:layout_marginTop="12dp"
                        android:layout_marginStart="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:progress="20"
                        android:min="10"
                        android:max="40"
                        />

                    <Button
                        android:id="@+id/advanced_setting_resetAllBasic_button"
